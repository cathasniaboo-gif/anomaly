# Copy this file to .env and fill in real values before running the server.

PORT=4000

# Required for all /api/admin/* routes (review queue, manual entries,
# publishing, triggering a scrape). Generate one with e.g.:
#   node -e "console.log(require('crypto').randomUUID())"
ADMIN_API_KEY=

# Where the JSON datastore lives. Defaults to backend/data if unset —
# make sure this path is on a persistent volume in production, or every
# deploy/restart wipes the review queue and known-updates dedup list.
DATA_DIR=

# Cron expression for the automatic scrape schedule. Defaults to every 6
# hours ("0 */6 * * *"). Set DISABLE_SCRAPE_SCHEDULE=true to turn it off
# entirely (e.g. if you're only curating manually, or triggering scrapes
# via POST /api/admin/scrape/run from an external scheduler instead).
SCRAPE_CRON=
DISABLE_SCRAPE_SCHEDULE=

# Sent as the scraper's User-Agent header. Identify yourself honestly.
SCRAPER_USER_AGENT=

# --- Audit module: accounting software connectors -------------------------
# Ledger scrutiny on manually imported CSVs works with none of these set.
# Fill in a connector's three vars to enable "Connect accounting software"
# for it — leave them blank to leave that connector greyed out in the app.
# See backend/src/audit/connectors/README.md for setup steps.

# QuickBooks Online (developer.intuit.com — create an app, add this exact
# redirect URI under it): QBO_REDIRECT_URI must be reachable from the
# browser that completes the OAuth flow, e.g.
# https://your-deployed-backend.example.com/api/audit/connectors/quickbooks/callback
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_ENVIRONMENT=sandbox

# Xero (developer.xero.com — create an app, add this exact redirect URI):
# https://your-deployed-backend.example.com/api/audit/connectors/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
